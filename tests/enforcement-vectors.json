      "policy": {
        "allowedModels": [
          "local-sovereign-8b",
          "local-sovereign-70b"
        ],
        "tokenBudget": 200000,
        "allowedUseCases": [
          "persona_variation",
          "journey_synthesis"
        ],
        "deniedUseCases": [
          "advertising"
        ],
        "purposeLimitation": true
      },
      "request": {
        "model": "local-sovereign-8b",
        "useCase": "persona_variation",
        "purpose": "vary persona reactions",
        "tokens": 1000
      },
      "expect": {
        "allow": true,
        "reasonCode": "ALLOWED",
        "policyDigest": "sha256:8e64692d2ad30b3cff36a71fb9768d51a0e59c3677520ead429e08da339dbaa2",
        "effectiveBudget": 200000
      }
    },
